# Plantilla de variables de entorno de VIAN. Copia a .env y rellena con tus valores.
# Supabase -> Connect -> ORMs -> Prisma (sustituye [YOUR-PASSWORD]).

# Pooler en modo transacción (puerto 6543) — usado por la app en ejecución.
DATABASE_URL="postgresql://postgres.XXXX:[YOUR-PASSWORD]@aws-0-XXXX.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — usada por las migraciones de Prisma.
DIRECT_URL="postgresql://postgres.XXXX:[YOUR-PASSWORD]@aws-0-XXXX.pooler.supabase.com:5432/postgres"
